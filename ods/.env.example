# ODS Configuration
# Copy this file to .env and edit values before starting:
#   cp .env.example .env
#
# The installer (install-core.sh) generates .env automatically with
# secure random secrets. This file documents all available variables.
#
# IMPORTANT: This file on branch feat/cafe-llama-enable-env must match upstream
# main body plus the cafe-llama block at the end. If you only see the short
# cafe-llama stub, restore from main and re-append the block from
# extensions/library/services/cafe-llama/README.md / docs/CAFE-LLAMA.md.
#
# --- cafe-llama optional block (also documented in docs/CAFE-LLAMA.md) ---
# CAFE_LLAMA_ENABLED=false
# CAFE_LLAMA_HOST=127.0.0.1
# EXT_CAFE_LLAMA_PORT=8081
# CAFE_LLAMA_PORT=8081
# CAFE_LLAMA_MODEL=
# CAFE_LLAMA_SERVER=
# CAFE_LLAMA_EXTRA_ARGS=
# LLAMA_ARG_HOST_MOE=
# LLAMA_ARG_N_HOST_MOE=
# LLAMA_ARG_CPU_MOE=
# LLAMA_ARG_N_CPU_MOE=
# LLAMA_ARG_SSD_STREAMING=
# LLAMA_ARG_N_SSD=
# LLAMA_ARG_CACHE_TYPE_K=turbo4
# LLAMA_ARG_CACHE_TYPE_V=turbo4
# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_SPEC_TYPE=draft-mtp
# LLAMA_ARG_SPEC_DRAFT_N_MAX=4
# LLAMA_ARG_PIPELINE_PARALLEL=
# LLAMA_ARG_NO_NGRAM=
# LLAMA_ARG_NGRAM_SSD=
